# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# SQLite (default for development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (uncomment and configure for production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pertamina_chatbot
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# LLM Configuration
OPENAI_API_KEY=your-openai-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=your-pinecone-env

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# LLM Configuration (local Ollama / model selection)
# Set the model you want Ollama to use. Example: qwen2.5:7b or llama3:8b
LLM_MODEL=qwen2.5:7b

# Optional: context and similarity tuning
MAX_CONTEXT_TOKENS=2000
MIN_SIMILARITY=0.35
SEMANTIC_THRESHOLD=0.65

# Optional: override Ollama host if running elsewhere
OLLAMA_HOST=http://localhost:11434

# ==========================================
# EMAIL CONFIGURATION (for Password Reset)
# ==========================================
# Email Backend Options:
# django.core.mail.backends.console.EmailBackend (development - prints to console)
# django.core.mail.backends.smtp.EmailBackend (production - sends via SMTP)

# For Development (using console backend - prints to console):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# For Production (using Gmail SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-specific-password

# For Production (using SendGrid):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key

DEFAULT_FROM_EMAIL=noreply@sitichatbot.pertamina.com

# Frontend URL (used in password reset emails)
FRONTEND_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://yourdomain.com
